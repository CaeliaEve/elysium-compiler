l,"notes":[{"key":"galacticraft:layout","source":"micdoodle8.mods.galacticraft.core.tile.TileEntityCircuitFabricator.updateInput","text":"text_0bb2906a8666c3bce2421b4f21ed8d0b27272d0447face20cccbc9285e479e09"},{"key":"galacticraft:outputState","source":"micdoodle8.mods.galacticraft.core.tile.TileEntityCircuitFabricator.compressItems","text":"text_552101ab5d4b32e43291359f2106a31e7218fca05649e3c8dc12a17e94157e19"}],"order":0,"outputs":[{"amount":null,"chance":{"denominator":"1","numerator":"1"},"change":null,"id":"item_e67a6b092895fbc30ae21c82a067627ce322030185f680fdcff6e83123b5abc1","kind":"item","quantity":{"condition":"nativeCircuitOutputState","kind":"potential","nominal":"3","sample":"3","stat":"galacticraft:circuitOutputState"},"role":"result","slot":6}],"process":{"basicItem":null,"capacity":"emptyOrOriginalCountSignedIntWithinLimits","directCall":"debitsEvenIfOutputRejected","hard":true,"inputDebit":"onCompletionOneWithoutContainers","kind":"circuitFabricator","matcher":"itemLiteralMetadataIgnoreCountAndTags","maxExtractGj":40,"nativeIndex":0,"nativeRegistry":"micdoodle8.mods.galacticraft.api.recipe.CircuitFabricatorRecipes","nativeTile":"micdoodle8.mods.galacticraft.core.tile.TileEntityCircuitFabricator","output":"item_e67a6b092895fbc30ae21c82a067627ce322030185f680fdcff6e83123b5abc1","outputAmount":"3","outputPolicy":"emptyCopiesPrototypeMergeKeepsExistingTags","overflow":"mergeAbove64SpawnsUntaggedUnitsIgnoringSpawnResult","priority":"firstMapEncounter","processingTicks":300,"quick":false,"rawOutputAmount":"3","slots":["item_f8e0a36db138a24785cfe004709a4a40eb427ff726ef507106c0ad63ee9cd323","item_9c9f283b8c7b1167e9dedfebed9847bc09f157c412259a787ad23736eb92cce3","item_dd5d59ec00c607339eea8ed7c9dcc02d1fb3ce88e8d3e966e51b6a5e37887869","item_103d63c7a46c723cdaaf40a6edc974d2a2cb045c9a7f1a56521c5ef432ee3ea6",null],"version":"3.3.13-GTNH","work":"consecutiveEligibleTicksResetOnBlocked"},"properties":{},"source":{"handler":"micdoodle8.mods.galacticraft.core.nei.CircuitFabricatorRecipeHandler","key":"native-circuit-gui-free","owner":"GalacticraftCore"}},"strings":[{"id":"text_0bb2906a8666c3bce2421b4f21ed8d0b27272d0447face20cccbc9285e479e09","locale":"zh_CN","text":"Input slots are native inventory indices 1 through 5, with required empty slots retained. Matching ignores count and NBT but uses literal metadata, including 32767, and the first HashMap encounter takes precedence. Each occupied slot loses one item at completion without crafting container returns."},{"id":"text_552101ab5d4b32e43291359f2106a31e7218fca05649e3c8dc12a17e94157e19","locale":"zh_CN","text":"Quick mode changes basic wafer metadata 13 to count 5 and metadata 14 to count 2. An empty output copies the result prototype; merging into an existing item/meta match preserves its NBT. Capacity admission uses the original result count with signed-int addition. Merged excess above 64 attempts single-item world spawns without prototype NBT, ignoring the spawn return value; the retained stack is capped at 64. Empty-output placement is not capped. Work requires 300 consecutive eligible ticks, and a blocked tick resets progress. The normal tick path gates completion; calling compressItems directly still debits inputs even if output is rejected. The displayed result is conditional, not a fixed final tag/placement guarantee."}]}