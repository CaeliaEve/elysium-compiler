ge":null,"id":"item_ffe3a3387745f5bd3e3a8c957a956edf3db18f39c4e8d6c7789d76b2aa0a5ae8","kind":"item","quantity":{"condition":"nativeLumbermillSlotAccepts","kind":"potential","nominal":"1","stat":"binnie:lumbermillOutputState"},"role":"result","slot":1},{"amount":null,"chance":{"denominator":"1","numerator":"1"},"change":null,"id":"item_67b6e753140e5ab7983499ef21243428c64cfea2fccc1cd91a2ef9665874954f","kind":"item","quantity":{"condition":"nativeLumbermillSlotAccepts","kind":"potential","nominal":"1","stat":"binnie:lumbermillOutputState"},"role":"result","slot":2}],"process":{"firstOreName":"binnieWrongFirst","fluidDrainLimit":10,"fluidGate":5,"inputPolicy":"normalFirstOreLogWoodRuntimeItemAndLiteralMetadata","kind":"binnieLumbermill","nativeCount":2,"nativeIndex":1,"outputPolicy":"emptyPrototypeMatchingMergeKeepsTagsBestEffortThenDebit","queuedTicks":30,"rfPerWorkTick":30,"startTicks":1,"tankPolicy":"normalWaterAdmissionRuntimeVolumeOnlyPartialDrain","version":"2.5.24","workPolicy":"cachedStateFloatProgressPauseResetAndReselectAtFinish","workTicks":30},"properties":{},"source":{"handler":"binnie.extratrees.nei.NEIHandlerLumbermill","key":"native-lumbermill-saved-input","owner":"ExtraTrees"}},"strings":[{"id":"text_09d19b7503b0503d5632e978acb2cdd558954c5381e3d3a8281479337a200335","locale":"en_US","text":"Water"},{"id":"text_ad86404a460ff1759143548f38c9f4d897b0810ae12488a96cf0e7044a153cfc","locale":"en_US","text":"The first native map entry matching item and literal metadata wins, ignoring input count and NBT, including literal 32767. Normal insertion needs the first ore name to contain logWood; saved runtime inventory does not repeat that admission check. Tank insertion accepts water, but runtime checks only whether 5 mB can be drained; each successful work tick drains up to 10 mB, including a partial drain. Work costs 30 RF per tick with native float progress 100/30 and a 0.01 start increment; uninterrupted fresh/queued cycles take 31/30 updates, not fixed wall time. Missing fluid or power pauses progress; inability to work resets it. Cached working state is separate from saved progress, and completion reselects the current wood. Output slots 1 planks, 2 bark and 3 sawdust independently copy into empty slots or merge matching item/meta while keeping existing NBT. Incompatible or over-capacity placement is skipped but one wood is still debited, without containers. The plank slot also has a pre-work capacity check; actual output depends on completion-time inventory, and the displayed items are empty-slot prototypes."}]}