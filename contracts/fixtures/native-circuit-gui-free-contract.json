ll,"notes":[{"key":"galacticraft:layout","source":"micdoodle8.mods.galacticraft.core.tile.TileEntityCircuitFabricator.updateInput","text":"text_bf57fe3900da4a9a181fc3a54f989339c3db3e9e6bee02639ad49daf96c813ff"},{"key":"galacticraft:outputState","source":"micdoodle8.mods.galacticraft.core.tile.TileEntityCircuitFabricator.compressItems","text":"text_e77753791a894a3acafe140786a2511a116435c73642f3389ed1091712e7b451"}],"order":0,"outputs":[{"amount":null,"chance":{"denominator":"1","numerator":"1"},"change":null,"id":"item_e67a6b092895fbc30ae21c82a067627ce322030185f680fdcff6e83123b5abc1","kind":"item","quantity":{"condition":"nativeCircuitOutputState","kind":"potential","nominal":"3","sample":"3","stat":"galacticraft:circuitOutputState"},"role":"result","slot":0}],"properties":{"galacticraft:emptySlots":{"name":"text_cab5b2f376a6fcde85aa81b889e17a39409beabc6c3eb8e0d929bc6e68a53197","value":{"kind":"list","values":[{"kind":"integer","value":"5"}]}},"galacticraft:energyPerTick":{"name":"text_a5682681be7c5968160cc555e14e39d3bae7c84bdbfca06d773070bdfa9093ff","value":{"kind":"integer","value":"40"}}},"source":{"handler":"micdoodle8.mods.galacticraft.core.nei.CircuitFabricatorRecipeHandler","key":"native-circuit-gui-free","owner":"GalacticraftCore"}},"strings":[{"id":"text_a5682681be7c5968160cc555e14e39d3bae7c84bdbfca06d773070bdfa9093ff","locale":"en_US","text":"Energy per tick (gJ/t)"},{"id":"text_cab5b2f376a6fcde85aa81b889e17a39409beabc6c3eb8e0d929bc6e68a53197","locale":"en_US","text":"Required empty machine slots"},{"id":"text_bf57fe3900da4a9a181fc3a54f989339c3db3e9e6bee02639ad49daf96c813ff","locale":"en_US","text":"Input slots are native inventory indices 1 through 5, with required empty slots retained. Matching ignores count and NBT but uses literal metadata, including 32767, and the first HashMap encounter takes precedence. Each occupied slot loses one item at completion without crafting container returns."},{"id":"text_e77753791a894a3acafe140786a2511a116435c73642f3389ed1091712e7b451","locale":"en_US","text":"Quick mode changes basic wafer metadata 13 to count 5 and metadata 14 to count 2. An empty output copies the result prototype; merging into an existing item/meta match preserves its NBT. Capacity admission uses the original result count. Quick-mode excess above 64 is dropped into the world without prototype NBT, while the retained stack is capped at 64. The displayed result is conditional on machine output state, not a fixed final tag/placement guarantee."}]}