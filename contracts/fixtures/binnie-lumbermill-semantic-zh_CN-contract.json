mount":null,"chance":{"denominator":"1","numerator":"1"},"change":null,"id":"item_ffe3a3387745f5bd3e3a8c957a956edf3db18f39c4e8d6c7789d76b2aa0a5ae8","kind":"item","quantity":{"condition":"nativeLumbermillSlotAccepts","kind":"potential","nominal":"1","stat":"binnie:lumbermillOutputState"},"role":"result","slot":1},{"amount":null,"chance":{"denominator":"1","numerator":"1"},"change":null,"id":"item_67b6e753140e5ab7983499ef21243428c64cfea2fccc1cd91a2ef9665874954f","kind":"item","quantity":{"condition":"nativeLumbermillSlotAccepts","kind":"potential","nominal":"1","stat":"binnie:lumbermillOutputState"},"role":"result","slot":2}],"process":{"firstOreName":"logWood","fluidDrainLimit":10,"fluidGate":5,"inputPolicy":"normalFirstOreLogWoodRuntimeItemAndLiteralMetadata","kind":"binnieLumbermill","nativeCount":1,"nativeIndex":0,"outputPolicy":"emptyPrototypeMatchingMergeKeepsTagsBestEffortThenDebit","queuedTicks":30,"rfPerWorkTick":30,"startTicks":1,"tankPolicy":"normalWaterAdmissionRuntimeVolumeOnlyPartialDrain","version":"2.5.24","workPolicy":"cachedStateFloatProgressPauseResetAndReselectAtFinish","workTicks":30},"properties":{},"source":{"handler":"binnie.extratrees.nei.NEIHandlerLumbermill","key":"binnie-lumbermill-semantic","owner":"ExtraTrees"}},"strings":[{"id":"text_d5b2bd3514464d041b8f28ffdb9e169efa19ad6422a4e9b2bc3b1301092b0e7d","locale":"zh_CN","text":"Water"},{"id":"text_b477a5bec6d2d35587a738ff3bffeae1744e5bca490b922437d33a06550644da","locale":"zh_CN","text":"按原生 map 遍历顺序选择同物品和精确元数据的第一项，忽略输入数量和 NBT，包括字面值 32767。正常插入要求首个矿辞名称包含 logWood；已保存库存的运行时加工不再执行该插入限制。储罐正常接收水，但运行时只检查能否取出 5 mB，每个成功工作 tick 最多排出 10 mB，允许部分排出。每步需 30 RF，原生浮点进度为 100/30，首次启动增加 0.01；无中断时首次 31 次更新、连续 30 次，非固定墙钟时长。缺少液体或能量会暂停，不能工作会重置；缓存的进行中标志与保存进度分别存在，完成时重新查询当前木材。三个物品输出槽按 1 木板/2 树皮/3 锯末独立尝试放入，空槽复制原型，同物品元数据合并保留已有 NBT；不兼容或超容量则跳过，仍扣一件木材，不返还容器。木板槽在工作前另有容量检查；实际产物仍取决于完成时槽位状态，图标是空输出槽的原型。"}]}